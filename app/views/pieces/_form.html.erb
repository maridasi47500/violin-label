<%= form_with(model: piece) do |form| %>
  <% if piece.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(piece.errors.count, "error") %> prohibited this piece from being saved:</h2>

      <ul>
        <% piece.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.select :name, ["concerto", "cappriccio", "sonate"] %>
  </div>
  <div>
    <%= form.label :relative, style: "display: block" %>
(write music relative to a note, or absolute notes, enter nothing)
    <%= form.text_field :relative %>
  </div>

  <div>
    <%= form.label :time_signature, style: "display: block" %>
    <%= form.text_field :time_signature %>
  </div>

  <div>
    <%= form.label :key_signature, style: "display: block" %>
    <%= form.text_field :key_signature %>
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.text_field :content %>
  </div>

  <div>
    <%= form.label :composer_id, style: "display: block" %>
    <%= form.select :composer_id, Composer.all.collect{|h|[h.name, h.id]} %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
